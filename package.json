{
  "name": "zebgen",
  "description": "manifest.json description",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "node scripts/check-staged-format.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node --test scripts/site.test.mjs",
    "test:chrome": "ZEBGEN_BUILD_OUT_DIR=.output-chrome-test npm run build && ZEBGEN_TEST_CHROME_EXTENSION=.output-chrome-test/chrome-mv3 node --test scripts/chromeScanRuntime.test.mjs",
    "test:firefox": "ZEBGEN_BUILD_OUT_DIR=.output-firefox-test npm run build:firefox && ZEBGEN_TEST_FIREFOX_EXTENSION=.output-firefox-test/firefox-mv2 node --test scripts/firefoxScanRuntime.test.mjs",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "release": "semantic-release",
    "test": "node --experimental-strip-types --no-warnings scripts/verifyMoneroMnemonic.mjs",
    "build:e2e": "wxt build --mode e2e"
  },
  "dependencies": {
    "@algorandfoundation/xhd-wallet-api": "2.0.0-canary.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "2.2.0",
    "@scure/bip39": "^2.2.0",
    "algosdk": "^3.6.0",
    "idb": "^8.0.3",
    "leakswap-utils": "2.0.0",
    "lucide-react": "^1.57.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zebgen-monero-wasm": "0.8.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "semantic-release": "^24.2.3",
    "typescript": "^5.9.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "web-ext-run": "0.2.4",
    "wxt": "^0.20.27"
  }
}
